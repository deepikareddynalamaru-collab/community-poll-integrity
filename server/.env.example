# Community Poll Integrity - Server Environment Variables

# Port Express listens on (default: 5000)
PORT=5000

# Environment mode ('development', 'production', or 'test')
# In production, MongoMemoryServer fallback is disabled and a valid MONGO_URI is required
NODE_ENV=development

# MongoDB connection string (Atlas cluster or self-hosted)
MONGO_URI=mongodb://localhost:27017/poll_integrity

# Secret key for JWT signing & verification (use a long, random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Allowed frontend origins for CORS (comma-separated list for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
